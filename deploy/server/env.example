HOST_PORT=8787

# Invite links default to the address used in the browser, so stale IPs in
# PUBLIC_BASE_URL will not break newly published links. Set MODE=env only when
# you want to force a fixed domain.
PUBLIC_BASE_URL=http://your-server-ip:8787
PUBLIC_BASE_URL_MODE=request

# Shared browser login key. Use a long random value in production.
TRAINING_ACCESS_KEY=change-this-access-key

# Direct model API for training material generation and quiz generation.
TRAINING_LLM_PROVIDER=auto
TRAINING_LLM_BASE_URL=https://api.deepseek.com/v1
TRAINING_LLM_MODEL=deepseek-chat
TRAINING_LLM_TEMPERATURE=1
TRAINING_LLM_API_KEY=change-this-api-key

# RAG retrieval: local uses a lightweight JSON vector index built with bge-m3.
TRAINING_HYBRID_RETRIEVAL=auto
TRAINING_VECTOR_BACKEND=local
TRAINING_EMBEDDING_MODEL=bge-m3
TRAINING_RAG_EMBEDDING_TIMEOUT_MS=8000
TRAINING_HEALTH_TIMEOUT_MS=800
OPENCLAW_CHAT_TIMEOUT_MS=120000
