HOST_PORT=8787

# Invite links default to the address used in the browser, so stale IPs in
# PUBLIC_BASE_URL will not break newly published links. Set MODE=env only when
# you want to force a fixed domain.
PUBLIC_BASE_URL=http://your-server-ip:8787
PUBLIC_BASE_URL_MODE=request

# Shared browser login key. Use a long random value in production.
TRAINING_ACCESS_KEY=change-this-access-key

# Storage defaults to SQLite. Set TRAINING_STORAGE=json only for rollback.
TRAINING_STORAGE=sqlite
TRAINING_SQLITE_BUSY_TIMEOUT_MS=5000

# backup-server.ps1 defaults. TRAINING_BACKUP_OUT can be an absolute directory
# or a specific .zip path; leave it empty to use data/training-index/backups.
TRAINING_BACKUP_RETENTION_DAYS=14
TRAINING_BACKUP_KEEP_LAST=10
# TRAINING_BACKUP_OUT=

# Direct model API for training material generation and quiz generation.
TRAINING_LLM_PROVIDER=auto
TRAINING_LLM_BASE_URL=https://api.deepseek.com/v1
TRAINING_LLM_MODEL=deepseek-chat
TRAINING_LLM_TEMPERATURE=1
TRAINING_LLM_API_KEY=change-this-api-key

# Optional Tavily web search for LLM generation chains. It stays off unless the
# browser/API request explicitly sends webSearchMode=on. Web results are external
# references only and are not written into the knowledge base.
TRAINING_WEB_SEARCH_PROVIDER=tavily
TRAINING_WEB_SEARCH_BASE_URL=https://api.tavily.com
TRAINING_WEB_SEARCH_MAX_RESULTS=5
TRAINING_WEB_SEARCH_TIMEOUT_MS=8000
TRAINING_WEB_SEARCH_SEARCH_DEPTH=basic
# TRAINING_WEB_SEARCH_API_KEY=change-this-tavily-key
# TAVILY_API_KEY=change-this-tavily-key

# Marketing article uniqueness guardrail. History comparison only checks recent
# boss-chat marketing articles and never writes web/search content into the KB.
TRAINING_MARKETING_UNIQUENESS_ENABLED=1
TRAINING_MARKETING_REWRITE_ATTEMPTS=2
TRAINING_MARKETING_HISTORY_LIMIT=50
TRAINING_MARKETING_HISTORY_DAYS=3
TRAINING_MARKETING_INTERNAL_REPEAT_MAX=0.18
TRAINING_MARKETING_BATCH_SIMILARITY_MAX=0.42
TRAINING_MARKETING_HISTORY_SIMILARITY_MAX=0.50
TRAINING_MARKETING_TITLE_SIMILARITY_MAX=0.65
TRAINING_MARKETING_TEMPLATE_HITS_MAX=2
TRAINING_MARKETING_MAX_ARTICLES=5

# RAG retrieval: local uses a lightweight JSON vector index built with bge-m3.
TRAINING_HYBRID_RETRIEVAL=auto
TRAINING_VECTOR_BACKEND=local
TRAINING_EMBEDDING_MODEL=bge-m3
TRAINING_RAG_EMBEDDING_TIMEOUT_MS=8000
TRAINING_HEALTH_TIMEOUT_MS=800
OPENCLAW_CHAT_TIMEOUT_MS=120000
